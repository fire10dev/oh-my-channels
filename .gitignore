# Media never goes in git — it lives next to the code (ignored) and is registered in the YT Hub DB.
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.m4a
*.flac
*.zip
node_modules/
.venv/
__pycache__/
.DS_Store
.build/
.buildtmp/
*.log

# shared media library: only the index + fetch scripts are tracked (licences forbid redistributing the files)
shared/library/**
!shared/library/
!shared/library/README.md
!shared/library/LICENSES.csv
!shared/library/build_licenses.py
!shared/library/*/
!shared/library/*/*/
!shared/library/**/fetch*.py

# render engine downloads / bundler caches
.remotion/
.cache/
