    "text": "DROPPED WEIGHT",
    "actor": "facepalm",
    "prop": "dumbbell"
   },
   {
    "vo": "Step up first. Set a five-minute check-in today.",
    "text": "START THE TALK",
    "color": "green",
    "actor": "sprint_start",
    "prop": "alarm_clock"
   },
   {
    "vo": "Break the silence before they have to drag it out.",
    "text": "SPEAK UP FIRST",
    "color": "gold",
    "actor": "front",
    "prop": "target"
   }
  ]
 },
