   },
   {
    "vo": "Drop every excuse and just stop talking.",
    "text": "JUST ZIP IT",
    "color": "green",
    "actor": "front"
   },
   {
    "vo": "A clean sorry leaves room for real listening.",
    "text": "CLEAN APOLOGY",
    "color": "gold",
    "actor": "meditating"
   }
  ]
 },
