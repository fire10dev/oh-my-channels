    "text": "THEIR TIME LOST",
    "color": "red",
    "actor": "facepalm",
    "prop": "hourglass"
   },
   {
    "vo": "Name the exact mistake and acknowledge the impact.",
    "text": "OWN THE IMPACT",
    "color": "green",
    "actor": "small_step",
