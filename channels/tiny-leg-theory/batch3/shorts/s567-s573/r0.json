[
 {
  "id": "s567",
  "mascot": "pen",
  "title": "The Silent Cost of Late Rent",
  "mechanism": "The Unwritten Rules",
  "lines": [
   {
    "vo": "I thought paying rent two days late was no big deal.",
    "text": "TWO DAYS LATE",
    "color": "red",
    "actor": "wallet_worry",
    "prop": "calendar_today"
   },
   {
    "vo": "We never signed rules, so why did a quiet war start?",
    "text": "QUIET CONFLICT",
    "color": "red",
    "actor": "confused_shrug",
    "prop": "storm_cloud"
   },
   {
    "vo": "Unspoken rules form an invisible contract inside every relationship.",
    "text": "UNWRITTEN RULES",
    "actor": "think",
    "prop": "brain"
   },
   {
    "vo": "When you miss a silent expectation, their sense of safety breaks.",
    "text": "BROKEN SAFETY",
    "color": "red",
    "actor": "worried_heart"
   },
   {
    "vo": "Sit down tonight and write one clear deadline together.",
    "text": "NAME THE RULE",
    "color": "green",
    "actor": "writing",
    "prop": "checkbox_tick"
   },
   {
    "vo": "What silent expectation are you leaving up to chance?",
    "text": "TALK TONIGHT",
    "color": "gold",
    "actor": "point_viewer"
   }
  ]
 },
