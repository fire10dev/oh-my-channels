 {
  "id": "s569",
  "mascot": "pen",
  "title": "Why Fast Apologies Can Backfire",
  "mechanism": "Effective Apology",
  "lines": [
   {
    "vo": "You apologized immediately, but their arms stayed firmly crossed.",
    "text": "APOLOGY REJECTED",
    "color": "red",
    "actor": "confused_shrug"
   },
   {
    "vo": "Tacking on traffic excuses turns an apology into a defense.",
    "text": "STOP EXCUSES",
    "color": "red",
    "actor": "hand_off",
    "prop": "storm_cloud"
   },
   {
    "vo": "They do not hear your good intentions.",
    "text": "NO EXCUSES HEARD",
    "actor": "worried_heart"
   },
   {
    "vo": "They only feel the disruption to their own day.",
    "text": "THEIR TIME LOST",
    "color": "red",
    "actor": "facepalm",
    "prop": "hourglass"
   },
   {
    "vo": "Name the exact mistake and acknowledge the impact.",
    "text": "OWN THE IMPACT",
    "color": "green",
    "actor": "writing",
    "prop": "checkbox_tick"
   },
   {
    "vo": "State what happened, then give them the silence to respond.",
    "text": "HOLD THE SILENCE",
    "color": "green",
    "actor": "meditating"
   },
   {
    "vo": "A clean sorry leaves room for real listening.",
    "text": "CLEAN APOLOGY",
    "color": "gold",
    "actor": "front"
   }
  ]
 },
