[
 {
  "id": "s567",
  "mascot": "pen",
  "title": "The Silent Cost of Late Rent",
  "mechanism": "The Unwritten Rules",
  "lines": [
   {
    "vo": "You paid rent two days late and thought it was fine.",
    "text": "TWO DAYS LATE",
    "color": "red",
    "actor": "wallet_worry",
    "prop": "calendar_today"
   },
   {
    "vo": "No written contract, yet an icy silence took over.",
    "text": "ICY SILENCE",
    "color": "red",
    "actor": "confused_shrug",
    "prop": "storm_cloud"
   },
   {
    "vo": "Unspoken rules form an invisible contract inside every relationship.",
    "text": "UNWRITTEN RULES",
    "actor": "think",
    "prop": "brain"
   },
   {
    "vo": "When you miss a silent expectation, their sense of safety breaks.",
    "text": "BROKEN SAFETY",
    "color": "red",
    "actor": "worried_heart"
   },
   {
    "vo": "Sit down tonight and write one clear deadline together.",
    "text": "NAME THE RULE",
    "color": "green",
    "actor": "writing",
    "prop": "checkbox_tick"
   },
   {
    "vo": "The rules you leave unsaid are the ones that hurt the most.",
    "text": "SAY IT OUT LOUD",
    "color": "gold",
    "actor": "think",
    "prop": "lightbulb"
   }
  ]
 },
