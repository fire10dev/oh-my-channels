 bảo: được ngâm nước miễn phí, không giới hạn."}, {"t": 20.75, "dur": 1.818, "text": "Công đoàn dưới nước cũng không có."}, {"t": 23.869, "dur": 2.013, "text": "Tao kể ở bản đầy đủ, link dưới."}], "comments": [], "voice": [{"t": 0.0, "src": "p05/vo/s250997538.wav"}, {"t": 4.056, "src": "p05/vo/127620730.wav"}, {"t": 7.05, "src": "p05/vo/125839804.wav"}, {"t": 13.498, "src": "p05/vo/s213371211.wav"}, {"t": 16.493, "src": "p05/vo/s139773936.wav"}, {"t": 20.75, "src": "p05/vo/s260092775.wav"}, {"t": 23.869, "src": "p05/vo/s169309536.wav"}], "mutes": [[22.619, 23.869]], "live": [], "music": {"src": "p01/music.wav", "len": 121.0, "vol": 0.13}}