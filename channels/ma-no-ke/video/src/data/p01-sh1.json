"subs": [
{
"t": 0.15,
"dur": 4.073,
"text": "Ba triệu người xem mẹ già ăn cơm. Không ai thấy con trai bà đổ mâm đi."
},
{
"t": 4.623,
"dur": 4.074,
"text": "Ba tháng trước, thằng con tôi mở kênh. Tên kênh: Bữa cơm với mẹ già."
},
{
"t": 8.947,
"dur": 2.489,
"text": "Mâm nào cũng cá kho, canh cua, trứng rán."
},
{
"t": 11.686,
"dur": 2.904,
"text": "Ba triệu người xem. Người ta khóc. Người ta donate."
},
{
"t": 14.839,
"dur": 3.905,
"text": "Tắt máy cái, nó dọn mâm. Đổ vào túi nilon, mang trả quán."
},
{
"t": 18.995,
"dur": 1.575,
"text": "Còn tôi ăn cháo trắng."
},
{
"t": 20.819,
"dur": 3.579,
"text": "Nó không ác đâu. Nó nợ app. Điện thoại rung cả ngày."
},
{
"t": 24.649,
"dur": 4.078,
"text": "Tôi không giận. Vì tôi cũng có bí mật. Đêm nào tôi cũng đi ăn khuya."
},
{
"t": 28.877,
"dur": 1.154,
"text": "Bằng cái đầu thôi."
},
{
"t": 30.631,
"dur": 4.17,
"text": "Bí mật của bà là gì? Mai tao kể. Bản đầy đủ ở trên kênh."
}
],
