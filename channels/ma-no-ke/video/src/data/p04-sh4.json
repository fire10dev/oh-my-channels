"subs": [
{
"t": 0.0,
"dur": 4.32,
"text": "Mâm đồng phong thủy, gõ một cái tài lộc về! Còn ba suất cuối! Chốt!"
},
{
"t": 4.57,
"dur": 3.49,
"text": "Mâm đồng. Ngày xưa gõ để gọi người về. Giờ gõ để gọi đơn về."
},
{
"t": 8.31,
"dur": 6.606,
"text": "Luật rõ ràng. Tao giấu, nhà nó đi tìm. Gõ mâm đồng, gọi tên. Có tiếng gõ là tao trả. Thế mới gọi là chơi."
},
{
"t": 15.166,
"dur": 2.601,
"text": "Tao giấu con nhà nó ba ngày, chỉ chờ một tiếng mâm."
},
{
"t": 18.017,
"dur": 2.311,
"text": "Nhà nó bán ba trăm cái mâm. Không gõ cái nào."
},
{
"t": 21.127,
"dur": 3.806,
"text": "Đến hai giờ sáng thì có người gõ. Tao kể ở bản đầy đủ, link dưới."
}
],
