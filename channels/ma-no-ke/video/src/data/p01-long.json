"subs": [
{
"t": 1.55,
"dur": 1.736,
"text": "Mở nhẹ thôi con. Nóng."
},
{
"t": 5.136,
"dur": 1.392,
"text": "Khoan. Đừng hỏi vội."
},
{
"t": 6.778,
"dur": 3.36,
"text": "Một bà cụ. Cái đầu. Trong nồi cơm điện. Đang lên sóng."
},
{
"t": 10.388,
"dur": 2.913,
"text": "Muốn biết vì sao thì lùi lại ba tháng. Tao kể."
},
{
"t": 13.801,
"dur": 4.074,
"text": "Ba tháng trước, thằng con tôi mở kênh. Tên kênh: Bữa cơm với mẹ già."
},
{
"t": 18.124,
"dur": 2.489,
"text": "Mâm nào cũng cá kho, canh cua, trứng rán."
},
{
"t": 20.863,
"dur": 2.904,
"text": "Ba triệu người xem. Người ta khóc. Người ta donate."
},
{
"t": 24.017,
"dur": 3.905,
"text": "Tắt máy cái, nó dọn mâm. Đổ vào túi nilon, mang trả quán."
},
{
"t": 28.172,
"dur": 1.575,
"text": "Còn tôi ăn cháo trắng."
},
{
"t": 29.997,
"dur": 3.579,
"text": "Nó không ác đâu. Nó nợ app. Điện thoại rung cả ngày."
},
{
"t": 33.826,
"dur": 4.078,
"text": "Tôi không giận. Vì tôi cũng có bí mật. Đêm nào tôi cũng đi ăn khuya."
},
{
"t": 38.055,
"dur": 1.154,
"text": "Bằng cái đầu thôi."
},
{
"t": 39.809,
"dur": 6.075,
"text": "Tôi là ma lai. Hai giờ sáng, đầu tôi nhấc khỏi cổ, bay qua song cửa. Trước khi gà gáy thì về lắp lại."
},
{
"t": 46.134,
"dur": 2.823,
"text": "Thành phố bây giờ khó bay lắm. Camera khắp nơi."
},
{
"t": 49.207,
"dur": 4.325,
"text": "Ăn gì à? Cá kho thừa ở thùng rác. Chia đôi với con mèo mướp. Nó đang chửa."
},
{
"t": 53.783,
"dur": 1.74,
"text": "Bà ngoại tôi dặn đúng một luật."
},
{
"t": 55.923,
"dur": 2.988,
"text": "Con ơi. Mẹ ngủ thì đừng đắp chăn lên cổ mẹ."
},
{
"t": 59.161,
"dur": 0.849,
"text": "Mẹ lại mê tín."
},
{
"t": 60.26,
"dur": 1.66,
"text": "Nó cười. Rồi nó quên."
},
{
"t": 62.42,
"dur": 4.494,
"text": "Rồi nó nghĩ ra trò mới: live cả lúc tôi ngủ. Tám tiếng chữa lành cùng mẹ già."
},
{
"t": 67.164,
"dur": 1.906,
"text": "Hai giờ bảy phút, bình luận nổ."
},
{
"t": 70.269,
"dur": 3.153,
"text": "Hôm sau, nó lắp thêm đèn. Chĩa thẳng ra cửa sổ."
},
{
"t": 73.673,
"dur": 4.485,
"text": "Đêm ấy camera quay được bốn giây. Bốn giây cái chăn, phẳng ở chỗ cổ."
},
{
"t": 79.158,
"dur": 7.128,
"text": "Cả mạng phát cuồng. Người phóng to từng điểm ảnh. Ông thầy phong thủy bán vòng tay chống ma lai, giảm giá năm mươi phần trăm."
},
{
"t": 86.536,
"dur": 2.203,
"text": "Người sợ ma. Ma sợ, thuật toán."
},
{
"t": 89.339,
"dur": 4.071,
"text": "Chỉ bà Hạnh phòng bên là không bình luận. Bà sang, ngồi, nhìn tôi rất lâu."
},
{
"t": 93.66,
"dur": 1.897,
"text": "Bà Tư này. Bà cẩn thận."
},
{
"t": 95.807,
"dur": 6.325,
"text": "Không phải, con bà cẩn thận. Mà là, bà cẩn thận. Hóa ra có người biết mình là ma, mà vẫn lo cho mình."
},
{
"t": 102.732,
"dur": 3.078,
"text": "Đêm đó nó gắn camera lên nóc tủ. Đặt tiêu đề:"
},
{
"t": 107.91,
"dur": 3.156,
"text": "Hai giờ mười lăm, nó ngủ gục. Chín nghìn người thức thay nó."
},
{
"t": 111.316,
"dur": 1.494,
"text": "Và đầu tôi, nhẹ dần."
},
{
"t": 113.61,
"dur": 2.904,
"text": "Điện thoại rung. Nó tỉnh. Nó nhìn sang giường."
},
{
"t": 116.764,
"dur": 1.818,
"text": "Cái chăn hoa. Phẳng ở chỗ cổ."
},
{
"t": 120.182,
"dur": 5.822,
"text": "Nó không hét. Nó không dám lật chăn. Tay run, nó kéo chăn trùm kín. Kín cổ. Kín hết."
},
{
"t": 126.255,
"dur": 4.904,
"text": "Ngoài cửa sổ, tôi thấy hết. Con tôi vừa đắp chăn cho mẹ, lần đầu tiên trong ba tháng."
},
{
"t": 131.408,
"dur": 1.488,
"text": "Và tôi không về được nữa."
},
{
"t": 133.897,
"dur": 4.345,
"text": "Tao suýt đánh rơi điếu cày. Còn hai tiếng là gà gáy. Bà ấy trốn đâu?"
},
{
"t": 138.492,
"dur": 2.742,
"text": "Chỗ nào tối, ấm, tròn vừa một cái đầu?"
},
{
"t": 141.484,
"dur": 0.986,
"text": "Cái nồi cơm điện."
},
{
"t": 142.97,
"dur": 7.74,
"text": "Gặp nắng là tan. Nhưng trong nồi cơm thì lấy đâu ra nắng. Năm mươi năm làm ma lai, lần đầu tôi ngủ trong nồi cơm. Ấm hơn cái chăn."
},
{
"t": 151.41,
"dur": 6.072,
"text": "Bảy giờ sáng. Live vẫn chạy. Ba trăm nghìn người. Và nó làm cái việc sáng nào cũng làm: mở nồi vo gạo."
},
{
"t": 158.582,
"dur": 1.657,
"text": "Mở nhẹ thôi con. Nóng."
},
{
"t": 163.789,
"dur": 4.454,
"text": "Tùng! Ai dạy mày trùm kín chăn người già thế! Mẹ mày ngạt bây giờ!"
},
{
"t": 168.493,
"dur": 3.49,
"text": "Bà Hạnh giật phăng cái chăn. Gió lùa vào cổ. Vút một cái."
},
{
"t": 172.233,
"dur": 5.404,
"text": "Đầu tôi về chỗ cũ. Tôi ngồi dậy, xoay cổ. Thằng Tùng ngất. Ba trăm nghìn người, vỗ tay."
},
{
"t": 178.438,
"dur": 5.733,
"text": "Clip ấy giờ ba mươi triệu view. Không ai tin là thật. Tốt. Không ai tin thì tôi vẫn đi ăn khuya được."
},
{
"t": 184.421,
"dur": 5.408,
"text": "Nó trả hết nợ. Tối nào vẫn dựng máy trước mâm. Nhưng tắt máy rồi, nó ngồi ăn với tôi."
},
{
"t": 190.079,
"dur": 1.819,
"text": "Còn tôi đưa nó một tờ giấy."
},
{
"t": 194.848,
"dur": 7.489,
"text": "Ma lai năm mươi năm chưa dọa được ai. Lên mạng ba tháng, có hợp đồng chia tiền. Tao ngồi nóc tủ mấy trăm năm, chưa ai trả đồng nào."
},
{
"t": 202.586,
"dur": 5.16,
"text": "Tuần sau: một ông công chức âm phủ đến xưởng may điểm danh, và điểm nhầm đúng một người."
},
{
"t": 207.996,
"dur": 3.723,
"text": "Bấm đăng ký đi. Không thì tối nay tao ngồi nóc tủ nhà mày đấy."
}
],
