"subs": [
{
"t": 0.0,
"dur": 3.105,
"text": "Cái hũ ba đời cấm mở. Sáng nay, mở trước nửa cái phố."
},
{
"t": 3.405,
"dur": 5.965,
"text": "Sáng thứ Bảy. Cửa kho tự mở. Hũ được đào lên trước mặt bên mua, luật sư, và nửa cái phố."
},
{
"t": 9.62,
"dur": 2.051,
"text": "Bốn trăm mười ba tờ. Giấy nợ, ông ạ."
},
{
"t": 11.921,
"dur": 3.225,
"text": "Cụ cố vay mua đất. Ông nội vay đắp lãi. Bố ông vay đảo nợ."
},
{
"t": 15.396,
"dur": 3.698,
"text": "Ba đời, chưa trả một đồng. Lần nào cũng cầm cố… chính căn nhà này."
},
{
"t": 19.693,
"dur": 4.357,
"text": "Chủ nợ thì ở ngay trong phố. Phố cổ mà. Nhà nào cũng còn giữ giấy."
},
{
"t": 24.3,
"dur": 4.24,
"text": "Nhà đang tranh chấp thì công chứng không ký. Bên em rút. Cọc anh đền."
},
{
"t": 29.04,
"dur": 4.728,
"text": "Mà nhớ dòng phụ lục ông Khải tự viết chứ? Nó quay lại cắn. Link bản đầy đủ ngay dưới."
}
],
