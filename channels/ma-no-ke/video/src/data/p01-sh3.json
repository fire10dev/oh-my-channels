"subs": [
{
"t": 0.15,
"dur": 1.906,
"text": "Hai giờ bảy phút, bình luận nổ."
},
{
"t": 3.256,
"dur": 3.741,
"text": "Thằng con tôi live cả lúc tôi ngủ. Tám tiếng chữa lành cùng mẹ già."
},
{
"t": 7.246,
"dur": 3.153,
"text": "Hôm sau, nó lắp thêm đèn. Chĩa thẳng ra cửa sổ."
},
{
"t": 10.65,
"dur": 7.128,
"text": "Cả mạng phát cuồng. Người phóng to từng điểm ảnh. Ông thầy phong thủy bán vòng tay chống ma lai, giảm giá năm mươi phần trăm."
},
{
"t": 18.028,
"dur": 2.203,
"text": "Người sợ ma. Ma sợ, thuật toán."
},
{
"t": 20.831,
"dur": 2.405,
"text": "Đêm sau, camera quay được bốn giây."
},
{
"t": 24.036,
"dur": 2.736,
"text": "Bốn giây đó quay được gì? Mai tao kể."
}
],
