"subs": [
{
"t": 4.3,
"dur": 2.48,
"text": "Bin ăn nhanh lên con. Mẹ đang live."
},
{
"t": 7.03,
"dur": 2.747,
"text": "Cứ giục đi. Có nhai cả đời… cũng không ra tiếng đâu."
},
{
"t": 10.577,
"dur": 4.979,
"text": "Lại mò vào à? Khách hôm nay làm nghề giấu người. Tám trăm năm, lần đầu tiên nó thua."
},
{
"t": 15.806,
"dur": 2.654,
"text": "Mà đến giờ nó vẫn chưa biết mình thua ai."
},
{
"t": 18.96,
"dur": 3.561,
"text": "Tao là ma giấu. Nghề tao: giấu người, chủ yếu trẻ con mải chơi."
},
{
"t": 22.772,
"dur": 6.606,
"text": "Luật rõ ràng. Tao giấu, nhà nó đi tìm. Gõ mâm đồng, gọi tên. Có tiếng gõ là tao trả. Thế mới gọi là chơi."
},
{
"t": 29.627,
"dur": 7.345,
"text": "Luật còn một cái hạn. Trước sáng ngày thứ tư, nhà nó phải đi tìm. Không ai tìm, đứa trẻ tự đi về, thì tám trăm năm nghề tao… thành trò cười."
},
{
"t": 37.222,
"dur": 3.632,
"text": "Tám trăm năm chưa hỏng lần nào. Cho đến căn hai bảy không tám."
},
{
"t": 41.354,
"dur": 4.977,
"text": "Bố họp trực tuyến. Mẹ livestream. Thằng con chơi game. Ba người, ba cái màn hình, một cái sofa."
},
{
"t": 46.581,
"dur": 4.32,
"text": "Mâm đồng phong thủy, gõ một cái tài lộc về! Còn ba suất cuối! Chốt!"
},
{
"t": 51.151,
"dur": 6.221,
"text": "Tối thứ Sáu, thằng Bin trốn làm bài, ra cầu thang thoát hiểm chơi game. Tao đóng cửa lại, che mắt cả nhà. Dễ."
},
{
"t": 57.872,
"dur": 2.75,
"text": "Tao ngồi chờ tiếng mâm. Chín giờ. Mười giờ. Nửa đêm."
},
{
"t": 60.871,
"dur": 3.42,
"text": "Không ai gõ. Bố tưởng Bin ở với mẹ. Mẹ tưởng Bin ở với bố."
},
{
"t": 64.541,
"dur": 3.25,
"text": "Chú cũng trốn học à? Ở đây bắt được wifi nhà cháu không chú?"
},
{
"t": 68.041,
"dur": 2.151,
"text": "Tám trăm năm, chưa đứa nào hỏi tao câu đó."
},
{
"t": 70.692,
"dur": 8.652,
"text": "Ngày thứ hai, thằng Bin đặt trà sữa, ghi chú: treo ở cửa thoát hiểm tầng hai bảy. Sạc ké ổ điện bảo trì. Nó gọi chỗ này là căn cứ bí mật."
},
{
"t": 79.593,
"dur": 2.006,
"text": "Tao là ma giấu, hay là trông trẻ?"
},
{
"t": 82.099,
"dur": 7.338,
"text": "Tao nặn một thằng Bin bằng bùn chậu cây, cho về ngồi sofa. Mắt hai hạt na. Nhìn là biết giả. Kiểu gì nhà nó cũng phát hiện, rồi đi tìm."
},
{
"t": 89.687,
"dur": 5.602,
"text": "Chiều ngày thứ ba, thằng bùn làm xong sạch bài tập cả tuần. Không cãi, không đòi điện thoại. Ngoan như tượng."
},
{
"t": 95.539,
"dur": 3.92,
"text": "Con nhà mình tự giác lắm cả nhà ơi. Bí quyết ở link dưới bình luận nha."
},
{
"t": 99.709,
"dur": 2.904,
"text": "Nhà nó phát hiện thật. Phát hiện ra… thằng này ngoan hơn."
},
{
"t": 103.212,
"dur": 3.337,
"text": "Bữa tối ngày thứ ba. Thằng bùn ngồi đúng ghế, cầm đúng máy tính bảng."
},
{
"t": 106.799,
"dur": 1.343,
"text": "Bốn người. Ba tiếng nhai."
},
{
"t": 110.892,
"dur": 2.24,
"text": "Hôm nay Bin ngoan thế. Không đòi gì."
},
{
"t": 113.382,
"dur": 1.68,
"text": "Ừ. Em xin phép tắt cam."
},
{
"t": 115.312,
"dur": 2.893,
"text": "Tao đứng ngoài ban công. Lần đầu tiên trong đời… tao sợ."
},
{
"t": 120.205,
"dur": 3.483,
"text": "Hết trà sữa rồi. Sáng mai cháu tự về. Mà mẹ cháu có hỏi cháu không?"
},
{
"t": 123.938,
"dur": 2.748,
"text": "Tao không trả lời. Nghề tao là giấu, không phải nói dối."
},
{
"t": 127.486,
"dur": 4.233,
"text": "Hai giờ sáng. Còn ba tiếng nữa là trời sáng. Nhà này không gõ, thì tao làm cho nó gõ."
},
{
"t": 131.969,
"dur": 1.634,
"text": "Tao rút cầu dao cả tầng."
},
{
"t": 134.103,
"dur": 2.154,
"text": "Rồi tao đập cửa thoát hiểm. Thình. Thình. Thình."
},
{
"t": 136.507,
"dur": 6.407,
"text": "Bà mẹ tưởng trộm vào cướp hàng. Vớ thứ gần nhất trên kệ: cái mâm đồng phong thủy. Phang thẳng vào cửa thoát hiểm."
},
{
"t": 143.164,
"dur": 2.0,
"text": "Bin đâu! Cầm đèn pin cho mẹ!"
},
{
"t": 145.414,
"dur": 4.903,
"text": "Gọi tên để sai cầm đèn pin. Luật không hỏi gọi để làm gì. Có tiếng mâm, có tên. Tao trả."
},
{
"t": 150.567,
"dur": 1.148,
"text": "Mẹ… mẹ tìm con à?"
},
{
"t": 152.315,
"dur": 4.526,
"text": "Sáng ra, nắng chiếu vào sofa. Thằng bùn rã thành một đống đất chậu cây."
},
{
"t": 157.09,
"dur": 1.44,
"text": "Tiếc thế. Đang ngoan."
},
{
"t": 158.93,
"dur": 6.322,
"text": "Thằng Bin thật kể chuyện ba ngày ở căn cứ bí mật được đúng hai câu. Rồi cả nhà lại cúi xuống điện thoại."
},
{
"t": 165.502,
"dur": 2.59,
"text": "Thằng bùn được học sinh giỏi. Tao đang tính mở trung tâm."
},
{
"t": 168.693,
"dur": 3.269,
"text": "Tối nay ăn cơm, đếm xem nhà mày có mấy tiếng nhai."
},
{
"t": 172.562,
"dur": 4.716,
"text": "Tập sau: bến cát lậu mùa lũ, và một con ma da bảy năm chưa được thay ca."
},
{
"t": 177.528,
"dur": 4.619,
"text": "Bấm đăng ký đi. Không thì mai mẹ mày gõ mâm, người về chưa chắc đã là mày."
}
],
