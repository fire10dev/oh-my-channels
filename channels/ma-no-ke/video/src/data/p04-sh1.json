"subs": [
{
"t": 0.0,
"dur": 3.575,
"text": "Hồ sơ ma giấu. Tám trăm năm giấu người, lần đầu phải trông trẻ."
},
{
"t": 3.775,
"dur": 2.555,
"text": "Một. Nó giấu người, chủ yếu trẻ con mải chơi."
},
{
"t": 6.579,
"dur": 3.41,
"text": "Hai. Nó che mắt. Đứa trẻ đứng ngay đấy, cả nhà không thấy."
},
{
"t": 10.239,
"dur": 4.502,
"text": "Ba. Muốn nó trả thì gõ mâm đồng, gọi tên. Ngày xưa mất đứa trẻ, cả làng ra gõ."
},
{
"t": 15.042,
"dur": 6.606,
"text": "Luật rõ ràng. Tao giấu, nhà nó đi tìm. Gõ mâm đồng, gọi tên. Có tiếng gõ là tao trả. Thế mới gọi là chơi."
},
{
"t": 22.147,
"dur": 2.638,
"text": "Ngày nay mất đứa trẻ… phải đợi điện thoại hết pin."
},
{
"t": 25.586,
"dur": 3.571,
"text": "Căn hai bảy không tám đợi ba ngày. Tao kể ở bản đầy đủ, link dưới."
}
],
