"subs": [
{
"t": 0.0,
"dur": 2.061,
"text": "…bốn trăm mười hai. Bốn trăm mười ba."
},
{
"t": 2.361,
"dur": 5.877,
"text": "Ba đời không ai được mở. Ba đời giàu nhất phố. Trong đầu ông Khải, cái hũ chỉ có thể là vàng."
},
{
"t": 8.538,
"dur": 3.954,
"text": "Đêm thứ Sáu, ông Khải vác xẻng xuống bếp. Định lấy vàng trước khi giao nhà."
},
{
"t": 12.742,
"dur": 2.922,
"text": "Ông chui vào kho lấy cuốc. Cửa kho đóng lại."
},
{
"t": 15.915,
"dur": 1.609,
"text": "Mở cửa! Tao là chủ nhà!"
},
{
"t": 17.774,
"dur": 3.54,
"text": "Con biết, ông ạ. Bán nhà thì phải kiểm kê. Cụ dặn. Con đếm cho ông nghe."
},
{
"t": 21.564,
"dur": 1.985,
"text": "…bốn trăm mười hai. Bốn trăm mười ba. Hết."
},
{
"t": 24.749,
"dur": 4.578,
"text": "Bốn trăm mười ba cái gì? Không phải vàng đâu. Tao kể hết ở bản đầy đủ, link ngay dưới."
}
],
