"subs": [
{
"t": 0.15,
"dur": 4.395,
"text": "Mi hijo me arropó por primera vez en tres meses. Y fue lo peor que pudo hacer."
},
{
"t": 4.945,
"dur": 7.103,
"text": "No gritó. No se atrevió a levantar la manta. Le temblaban las manos mientras me tapaba por completo. Hasta el cuello. Todo."
},
{
"t": 12.298,
"dur": 2.225,
"text": "Desde afuera de la ventana, lo vi todo."
},
{
"t": 14.773,
"dur": 1.485,
"text": "Y ya no pude regresar."
},
{
"t": 17.258,
"dur": 5.292,
"text": "Casi se me cae la pipa de agua. Faltaban dos horas para que cantara el gallo. ¿Dónde se escondió?"
},
{
"t": 22.8,
"dur": 3.669,
"text": "¿Qué lugar es oscuro, cálido y del tamaño justo para una cabeza?"
},
{
"t": 26.968,
"dur": 3.33,
"text": "Adivina en los comentarios. La próxima vez abro la tapa."
}
],
