"subs": [
{
"t": 0.0,
"dur": 4.608,
"text": "¡Bandeja de latón para la buena suerte! ¡Un golpe y llega la fortuna! ¡Quedan tres! ¡Vendido!"
},
{
"t": 4.858,
"dur": 4.958,
"text": "Bandeja de latón. Antes se golpeaba para llamar a la gente. Ahora, para llamar pedidos."
},
{
"t": 10.066,
"dur": 7.255,
"text": "Reglas simples. Yo los escondo, su familia los busca. Golpea la bandeja de latón y di su nombre. Un golpe y lo devuelvo. Así se juega."
},
{
"t": 17.572,
"dur": 2.928,
"text": "Escondí a su hijo tres días, esperando un solo golpe."
},
{
"t": 20.75,
"dur": 2.866,
"text": "Vendieron trescientas bandejas. No golpearon ni una."
},
{
"t": 24.415,
"dur": 4.842,
"text": "A las dos de la madrugada, por fin alguien golpeó. Episodio completo: enlace abajo."
}
],
