"subs": [
{
"t": 0.15,
"dur": 2.708,
"text": "A las dos y siete, estallaron los comentarios."
},
{
"t": 4.058,
"dur": 4.221,
"text": "Mi hijo transmitía mientras yo dormía. Ocho horas de sanación con mamá."
},
{
"t": 8.529,
"dur": 3.094,
"text": "Al día siguiente, puso otra luz. Directo a la ventana."
},
{
"t": 11.873,
"dur": 8.047,
"text": "Internet enloqueció. La gente amplió cada píxel. Un experto en feng shui vendía pulseras contra ma lai con cincuenta por ciento de descuento."
},
{
"t": 20.17,
"dur": 3.88,
"text": "La gente teme a los fantasmas. Los fantasmas temen al algoritmo."
},
{
"t": 24.649,
"dur": 3.033,
"text": "La noche siguiente, la cámara captó cuatro segundos."
},
{
"t": 28.482,
"dur": 3.395,
"text": "¿Qué captaron esos cuatro segundos? Te cuento la próxima vez."
}
],
