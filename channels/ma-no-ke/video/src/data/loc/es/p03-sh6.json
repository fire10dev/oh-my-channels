"subs": [
{
"t": 0.0,
"dur": 2.256,
"text": "…cuatrocientos doce. Cuatrocientos trece."
},
{
"t": 2.557,
"dur": 8.691,
"text": "Nadie lo abrió en tres generaciones. La familia fue la más rica de la cuadra por tres generaciones. Para el señor Khai, el frasco solo podía tener oro."
},
{
"t": 11.547,
"dur": 6.611,
"text": "El viernes por la noche, el señor Khai bajó a la cocina con una pala. Quería sacar el oro antes de entregar la casa."
},
{
"t": 18.408,
"dur": 3.01,
"text": "Entró al depósito por un pico. La puerta se cerró."
},
{
"t": 21.669,
"dur": 1.447,
"text": "¡Abre! ¡Esta casa es mía!"
},
{
"t": 23.365,
"dur": 5.444,
"text": "Lo sé, señor. Para vender una casa hay que hacer inventario. Eso dijo el tatarabuelo. Voy a contarle."
},
{
"t": 29.059,
"dur": 2.938,
"text": "…cuatrocientos doce. Cuatrocientos trece. Eso es todo."
},
{
"t": 33.198,
"dur": 4.913,
"text": "¿Cuatrocientos trece qué? No es oro. Te cuento todo en el episodio completo, justo abajo."
}
],
