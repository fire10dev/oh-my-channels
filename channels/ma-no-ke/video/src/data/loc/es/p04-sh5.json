"subs": [
{
"t": 1.65,
"dur": 5.984,
"text": "Papá está en una videollamada. Mamá transmite en vivo. El niño juega. Tres personas, tres pantallas, un sofá."
},
{
"t": 7.884,
"dur": 4.453,
"text": "Este papá pasó tres días en videollamadas. Ni idea de dónde estaba su hijo."
},
{
"t": 12.586,
"dur": 2.413,
"text": "Bin se porta tan bien hoy. No ha pedido nada."
},
{
"t": 15.249,
"dur": 2.56,
"text": "El niño sentado era de barro. Papá asintió."
},
{
"t": 18.11,
"dur": 1.626,
"text": "Sí. Voy a apagar la cámara."
},
{
"t": 20.536,
"dur": 2.822,
"text": "Tres días. Dijo exactamente una cosa. Esa cosa."
},
{
"t": 23.957,
"dur": 3.587,
"text": "¿Dónde está el niño de verdad? Episodio completo: enlace abajo."
}
],
