"subs": [
{
"t": 0.0,
"dur": 3.347,
"text": "Cómo sobrevivir a un ma giau. Aprende de Bin, de diez años."
},
{
"t": 3.547,
"dur": 3.336,
"text": "Esperé el golpe de la bandeja. Las nueve. Las diez. Medianoche."
},
{
"t": 7.133,
"dur": 2.768,
"text": "Uno. No entres en pánico. Pregunta por el wifi."
},
{
"t": 10.001,
"dur": 3.957,
"text": "¿Tú también te escapas de la tarea, señor? ¿Aquí llega el wifi de mi casa?"
},
{
"t": 14.208,
"dur": 2.886,
"text": "En ochocientos años, nadie me había preguntado eso."
},
{
"t": 17.393,
"dur": 3.538,
"text": "Dos. Pide té con leche. Nota: dejar en la puerta de emergencia."
},
{
"t": 21.181,
"dur": 3.458,
"text": "Tres. Usa un enchufe de mantenimiento. Llámalo base secreta."
},
{
"t": 25.04,
"dur": 1.651,
"text": "¿Soy un ma giau o una niñera?"
},
{
"t": 27.491,
"dur": 4.252,
"text": "Su familia no lo buscó en tres días. Episodio completo: enlace abajo."
}
],
