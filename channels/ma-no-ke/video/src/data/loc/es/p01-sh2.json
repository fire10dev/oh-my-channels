"subs": [
{
"t": 0.15,
"dur": 1.668,
"text": "Mamá solo me dio una regla."
},
{
"t": 2.218,
"dur": 10.145,
"text": "Soy una ma lai, un fantasma cuya cabeza vuela sola. A las dos de la madrugada, mi cabeza se desprende y sale volando por la ventana. Me la pongo de nuevo antes de que cante el gallo."
},
{
"t": 12.613,
"dur": 4.002,
"text": "Ahora es difícil volar por la ciudad. Hay cámaras por todas partes."
},
{
"t": 16.865,
"dur": 5.829,
"text": "¿Qué como? Pescado estofado que quedó en la basura. Lo comparto con una gata atigrada. Está embarazada."
},
{
"t": 22.944,
"dur": 1.929,
"text": "Mi abuela me dio una sola regla."
},
{
"t": 25.273,
"dur": 4.151,
"text": "Escúchame, hijo. Cuando esté dormida, no me subas la manta hasta el cuello."
},
{
"t": 29.674,
"dur": 1.825,
"text": "Mamá, eso es pura superstición."
},
{
"t": 31.749,
"dur": 1.625,
"text": "Se rio. Y luego lo olvidó."
},
{
"t": 33.974,
"dur": 2.897,
"text": "¿Qué noche lo olvidó? Te cuento la próxima vez. Sígueme."
}
],
