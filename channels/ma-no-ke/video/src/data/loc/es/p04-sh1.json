"subs": [
{
"t": 0.0,
"dur": 4.521,
"text": "Expediente ma giau. Ochocientos años escondiendo gente; primera vez de niñera."
},
{
"t": 4.722,
"dur": 3.56,
"text": "Uno. Esconde gente, sobre todo niños que no dejan de jugar."
},
{
"t": 8.531,
"dur": 4.027,
"text": "Dos. Les nubla la vista. El niño está ahí mismo y su familia no lo ve."
},
{
"t": 12.809,
"dur": 7.189,
"text": "Tres. Para recuperar al niño, golpea una bandeja de latón y di su nombre. Antes, si un niño desaparecía, todo el pueblo golpeaba."
},
{
"t": 20.298,
"dur": 7.255,
"text": "Reglas simples. Yo los escondo, su familia los busca. Golpea la bandeja de latón y di su nombre. Un golpe y lo devuelvo. Así se juega."
},
{
"t": 28.053,
"dur": 3.813,
"text": "Hoy, si un niño desaparece… hay que esperar a que se apague el teléfono."
},
{
"t": 32.666,
"dur": 5.302,
"text": "El departamento dos siete cero ocho esperó tres días. Episodio completo: enlace abajo."
}
],
