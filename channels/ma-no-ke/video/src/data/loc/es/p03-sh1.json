"subs": [
{
"t": 0.0,
"dur": 4.414,
"text": "Expediente ma xo. Si tu familia lleva tres generaciones aquí, escucha bien."
},
{
"t": 4.614,
"dur": 6.845,
"text": "Uno. Es un niño sentado en una esquina, casi siempre en la cocina. Está ahí desde los tiempos del tatarabuelo. Nunca se ha ido."
},
{
"t": 11.709,
"dur": 3.146,
"text": "Dos. Cuida las cosas de la familia. Nada sale de la casa."
},
{
"t": 14.954,
"dur": 3.679,
"text": "Si venden la casa, sus cosas se van. Tengo que mantenerlas aquí."
},
{
"t": 18.932,
"dur": 4.608,
"text": "Tres. Es muy educado. Se llama «tu hijo» y te dice «señor». Da miedo de tan educado."
},
{
"t": 23.641,
"dur": 1.813,
"text": "No asusto a nadie. Solo cuento."
},
{
"t": 25.753,
"dur": 5.046,
"text": "Cuatro. ¿Oyes que cuentan detrás de la pared a medianoche? No te alegres. Quizá no sea dinero."
},
{
"t": 31.5,
"dur": 5.42,
"text": "El tatarabuelo me encargó una cosa: toda la fortuna está en el frasco bajo la cocina. Cuídalo. Y lo hice."
},
{
"t": 37.52,
"dur": 5.039,
"text": "En casa del señor Khai, contó hasta cuatrocientos trece. Historia completa en el canal."
}
],
