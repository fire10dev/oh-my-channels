"subs": [
{
"t": 0.0,
"dur": 2.792,
"text": "Cómo sobrevivir a un ma xo en casa. Tres reglas."
},
{
"t": 2.992,
"dur": 5.969,
"text": "Uno. No vendas la casa. Entra el topógrafo, la puerta se cierra y queda atrapado dos horas en el baño."
},
{
"t": 9.211,
"dur": 3.679,
"text": "Si venden la casa, sus cosas se van. Tengo que mantenerlas aquí."
},
{
"t": 13.19,
"dur": 3.669,
"text": "Dos. No lo sobornes. Se come la ofrenda, pero no hace el trabajo."
},
{
"t": 17.109,
"dur": 3.697,
"text": "No acepto sobornos, señor. Solo como ofrendas de pastel de arroz."
},
{
"t": 21.206,
"dur": 5.375,
"text": "Tres. No abras el frasco bajo la cocina. Si nadie lo abrió en tres generaciones, por algo será."
},
{
"t": 27.081,
"dur": 3.904,
"text": "¿Ya lo abriste? Felicidades. Todo lo que hay en el frasco es tuyo. Todo."
},
{
"t": 31.786,
"dur": 4.217,
"text": "El señor Khai lo abrió. ¿Qué hay en el frasco? Historia completa en el canal."
}
],
