"subs": [
{
"t": 0.0,
"dur": 4.551,
"text": "Para vender la casa, el señor Khai tuvo que sobornar al fantasma que la cuidaba."
},
{
"t": 4.701,
"dur": 6.641,
"text": "Soy el ma xo de esta casa: un fantasma del rincón de la cocina. Vivo junto a la estufa desde los tiempos del tatarabuelo."
},
{
"t": 11.542,
"dur": 4.473,
"text": "Oye, ma xo. Firma y te doy tu parte. Toma. Ofrenda de pastel de arroz con plátano."
},
{
"t": 17.565,
"dur": 2.477,
"text": "¡Te lo comiste! ¡Eso significa que aceptas!"
},
{
"t": 20.242,
"dur": 3.697,
"text": "No acepto sobornos, señor. Solo como ofrendas de pastel de arroz."
},
{
"t": 24.839,
"dur": 4.095,
"text": "Se come la ofrenda y no hace el trabajo. Ese sí es el empleo que quiero."
},
{
"t": 29.335,
"dur": 6.168,
"text": "El soborno no funcionó y el señor Khai desenterró el frasco. ¿Qué encontró? Historia completa en el canal."
}
],
