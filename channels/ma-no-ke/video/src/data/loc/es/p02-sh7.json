"subs": [
{
"t": 0.15,
"dur": 2.534,
"text": "No me llevo su vida. Me llevo su horario."
},
{
"t": 2.983,
"dur": 8.091,
"text": "La noche cuarenta y ocho, corrigió el informe. Dos y diez. En la fábrica. Accidente laboral. La indemnización llegó a manos de la esposa de Loc."
},
{
"t": 11.324,
"dur": 6.396,
"text": "Las dos y diez no son una hora maldita. Ya no hay familiares en el expediente. Mi autoridad termina aquí."
},
{
"t": 17.97,
"dur": 3.809,
"text": "Ahora el reloj tiene botón de salida. Las horas extra se pagan."
},
{
"t": 22.03,
"dur": 4.817,
"text": "Ah. Se arrodilló tarde tres noches. Este mes, descuéntale el bono de asistencia."
},
{
"t": 27.447,
"dur": 6.089,
"text": "Trescientos años sentado en armarios y es la primera vez que veo al inframundo ser más puntual que una empresa."
},
{
"t": 33.786,
"dur": 6.951,
"text": "La próxima vez: un niño que guarda el tesoro de tres generaciones en una casa antigua, y un frasco que nadie puede abrir."
},
{
"t": 40.987,
"dur": 4.506,
"text": "Suscríbete. Si no, esta noche a las tres, el reloj de tu casa imprimirá tu nombre."
}
],
