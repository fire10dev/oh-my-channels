"subs": [
{
"t": 0.15,
"dur": 4.618,
"text": "Tres millones vieron comer a una anciana. Nadie vio a su hijo tirar la comida."
},
{
"t": 5.168,
"dur": 3.939,
"text": "Hace tres meses, mi hijo abrió un canal. Lo llamó La cena con mamá."
},
{
"t": 9.358,
"dur": 3.905,
"text": "En cada comida: pescado estofado, sopa de cangrejo y huevos fritos."
},
{
"t": 13.513,
"dur": 3.218,
"text": "Tres millones de espectadores. Lloraban. Mandaban dinero."
},
{
"t": 16.98,
"dur": 5.441,
"text": "Apenas apagaba la cámara, recogía todo. A una bolsa de plástico y de vuelta al restaurante."
},
{
"t": 22.671,
"dur": 1.967,
"text": "Yo comía arroz blanco aguado."
},
{
"t": 24.888,
"dur": 3.671,
"text": "No es malo. Le debe a una app. El teléfono le vibra todo el día."
},
{
"t": 28.809,
"dur": 5.014,
"text": "No estoy enojada. Yo también tengo un secreto. Todas las noches me escapo a comer algo."
},
{
"t": 33.972,
"dur": 1.227,
"text": "Solo con la cabeza."
},
{
"t": 35.8,
"dur": 4.269,
"text": "¿Cuál es su secreto? Te cuento la próxima vez. Historia completa en el canal."
}
],
