"subs": [
{
"t": 0.15,
"dur": 5.011,
"text": "My son tucked me in for the first time in three months. And it was the worst thing he could've done."
},
{
"t": 5.561,
"dur": 6.686,
"text": "He didn't scream. He didn't dare lift the blanket. His hands shook as he pulled it over me. Up to my neck. All the way."
},
{
"t": 12.496,
"dur": 1.8,
"text": "Outside the window, I saw it all."
},
{
"t": 14.546,
"dur": 1.214,
"text": "And I couldn't get back."
},
{
"t": 16.759,
"dur": 4.696,
"text": "I nearly dropped my water pipe. Two hours till the rooster crowed. Where'd she hide?"
},
{
"t": 21.706,
"dur": 2.946,
"text": "Where's dark and warm, and just the right size for a head?"
},
{
"t": 25.151,
"dur": 2.278,
"text": "Guess below. I'll open the lid next time."
}
],
