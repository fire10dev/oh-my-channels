"subs": [
{
"t": 0.0,
"dur": 4.915,
"text": "Feng shui brass tray! One bang brings good fortune! Just three left! Sold!"
},
{
"t": 5.165,
"dur": 4.667,
"text": "Brass tray. Once banged to call people home. Now banged to call in orders."
},
{
"t": 10.082,
"dur": 6.899,
"text": "Simple rules. I hide them, their family looks. Bang the brass tray, call their name. One bang and I bring them back. That's a game."
},
{
"t": 17.231,
"dur": 2.876,
"text": "I hid their kid for three days, waiting for one tray bang."
},
{
"t": 20.357,
"dur": 2.727,
"text": "They sold three hundred trays. Didn't bang a single one."
},
{
"t": 23.882,
"dur": 3.695,
"text": "At two a.m., someone finally banged. Full story on the channel."
}
],
