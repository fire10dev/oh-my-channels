"subs": [
{
"t": 0.0,
"dur": 6.3,
"text": "A jar nobody dared open for three generations. This morning, half the neighborhood watched it open."
},
{
"t": 6.6,
"dur": 8.344,
"text": "Saturday morning. The storage room door opened by itself. They dug up the jar in front of the buyers, their lawyer, and half the neighborhood."
},
{
"t": 15.195,
"dur": 2.613,
"text": "Four hundred thirteen papers. I.O.U.s, sir."
},
{
"t": 18.058,
"dur": 6.444,
"text": "Great-great-grandpa borrowed to buy land. Grandpa borrowed to cover the interest. Your dad borrowed to refinance."
},
{
"t": 24.752,
"dur": 4.358,
"text": "Three generations. Not one payment. Every time, they put up… this very house."
},
{
"t": 29.708,
"dur": 5.06,
"text": "The lenders live right here. It's the old quarter. Every house still has the paperwork."
},
{
"t": 35.019,
"dur": 4.607,
"text": "A notary can't sign off on a disputed house. We're out. You forfeit the deposit."
},
{
"t": 40.126,
"dur": 6.442,
"text": "Remember that addendum Mr. Khai wrote himself? It came back to bite him. Full episode right below."
}
],
