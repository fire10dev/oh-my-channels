"subs": [
{
"t": 2.6,
"dur": 6.163,
"text": "Saturday, three a.m. At the factory. I strike the wooden bell three times and open the case file."
},
{
"t": 9.014,
"dur": 4.86,
"text": "One family member to check in. The report says: Nguyen Van Phat. “Like family.”"
},
{
"t": 14.123,
"dur": 1.984,
"text": "I check in the family member."
},
{
"t": 17.858,
"dur": 2.6,
"text": "At that exact second, the boss's phone lit up."
},
{
"t": 22.258,
"dur": 1.584,
"text": "I'm the boss! I'm not his family!"
},
{
"t": 24.242,
"dur": 3.489,
"text": "What does the than trung say? I'll tell you next time. Follow along."
}
],
