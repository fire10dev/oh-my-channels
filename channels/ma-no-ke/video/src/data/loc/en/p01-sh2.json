"subs": [
{
"t": 0.15,
"dur": 1.644,
"text": "Mom gave me just one rule."
},
{
"t": 2.194,
"dur": 8.646,
"text": "I'm a ma lai — a head-flying ghost. At two a.m., my head lifts off and flies out the window. I put it back before the rooster crows."
},
{
"t": 11.09,
"dur": 3.074,
"text": "Flying around town is hard now. Cameras everywhere."
},
{
"t": 14.413,
"dur": 5.604,
"text": "What do I eat? Leftover braised fish from the trash. I split it with a tabby cat. She's pregnant."
},
{
"t": 20.268,
"dur": 1.687,
"text": "My grandma gave me one rule."
},
{
"t": 22.355,
"dur": 3.477,
"text": "Listen, son. When I'm asleep, don't pull the blanket up to my neck."
},
{
"t": 26.081,
"dur": 1.427,
"text": "Mom, that's just superstition."
},
{
"t": 27.759,
"dur": 1.467,
"text": "He laughed. Then forgot."
},
{
"t": 29.825,
"dur": 3.393,
"text": "Which night did he forget? I'll tell you next time. Follow me."
}
],
