"subs": [
{
"t": 0.15,
"dur": 3.623,
"text": "Fifty percent of the revenue. Because this head belongs to Mom."
},
{
"t": 4.173,
"dur": 8.058,
"text": "That clip has thirty million views now. Nobody believes it's real. Good. If they don't believe, I can still sneak out for a late meal."
},
{
"t": 12.481,
"dur": 6.266,
"text": "He paid off his debts. He still sets up the camera at dinner. But when he turns it off, he sits and eats with me."
},
{
"t": 18.997,
"dur": 1.741,
"text": "And I gave him a piece of paper."
},
{
"t": 23.489,
"dur": 10.42,
"text": "Fifty years as a ma lai, and she never scared anyone. Three months online, and she's got a revenue deal. I've sat on cabinets for centuries. Nobody's paid me a dime."
},
{
"t": 34.158,
"dur": 7.088,
"text": "Next time: an underworld clerk shows up at a sewing shop to take attendance, and marks exactly one person wrong."
},
{
"t": 41.495,
"dur": 3.654,
"text": "Hit subscribe. Or tonight I'll be sitting on top of your cabinet."
}
],
