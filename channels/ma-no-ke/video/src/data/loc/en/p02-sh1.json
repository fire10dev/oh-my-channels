"subs": [
{
"t": 0.15,
"dur": 3.963,
"text": "This factory time clock only has a clock-in button. No clock-out."
},
{
"t": 4.413,
"dur": 5.466,
"text": "Case file. Phat Dat Garment Factory. Three hundred workers. Night shift till two a.m."
},
{
"t": 10.13,
"dur": 3.032,
"text": "Director Phat. His catchphrase: “The factory is home.”"
},
{
"t": 13.412,
"dur": 3.853,
"text": "Overtime is dedication! Leave early, lose your attendance bonus!"
},
{
"t": 17.665,
"dur": 5.958,
"text": "Tran Van Loc. Sewing team three. Thursday, two ten a.m. He slumped over his sewing machine."
},
{
"t": 23.874,
"dur": 3.612,
"text": "He didn't get back up. The log says: two ten. At the factory."
},
{
"t": 28.086,
"dur": 1.92,
"text": "Mr. Loc… Mr. Loc."
},
{
"t": 30.506,
"dur": 5.62,
"text": "The first thing the boss asked wasn't how Loc was doing. He asked if the camera covered that spot."
},
{
"t": 36.375,
"dur": 4.098,
"text": "What was the boss up to? I'll tell you next time. Full story on the channel."
}
],
