"subs": [
{
"t": 0.0,
"dur": 5.146,
"text": "Ma giau case file. Eight hundred years hiding people, first time babysitting."
},
{
"t": 5.346,
"dur": 3.417,
"text": "One. It hides people, mostly kids who won't quit playing."
},
{
"t": 9.012,
"dur": 4.357,
"text": "Two. It clouds their eyes. The kid's right there, and the family can't see him."
},
{
"t": 13.619,
"dur": 6.657,
"text": "Three. To get the kid back, bang a brass tray and call their name. When a child went missing, the whole village banged."
},
{
"t": 20.576,
"dur": 6.899,
"text": "Simple rules. I hide them, their family looks. Bang the brass tray, call their name. One bang and I bring them back. That's a game."
},
{
"t": 27.975,
"dur": 3.634,
"text": "These days, a kid goes missing… you wait for the phone to die."
},
{
"t": 32.41,
"dur": 4.741,
"text": "Apartment two seven zero eight waited three days. Full story on the channel."
}
],
