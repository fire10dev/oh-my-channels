"subs": [
{
"t": 0.0,
"dur": 3.181,
"text": "How to survive a ma xo in your house. Three rules."
},
{
"t": 3.381,
"dur": 6.061,
"text": "One. Don't sell the house. The surveyor comes in, the door locks, and he's stuck in the bathroom for two hours."
},
{
"t": 9.692,
"dur": 3.322,
"text": "Sell the house, and the house's things leave. I have to keep them here."
},
{
"t": 13.314,
"dur": 3.712,
"text": "Two. Don't bribe it. It'll eat the offering, but it won't do the job."
},
{
"t": 17.277,
"dur": 3.073,
"text": "I don't take bribes, sir. I only eat rice cake offerings."
},
{
"t": 20.749,
"dur": 5.32,
"text": "Three. Don't open the jar under the kitchen. Three generations left it shut for a reason."
},
{
"t": 26.57,
"dur": 4.956,
"text": "Already opened it? Congratulations. Everything in the jar is yours. All of it."
},
{
"t": 32.325,
"dur": 3.833,
"text": "Mr. Khai opened it. What's in the jar? Full story on the channel."
}
],
