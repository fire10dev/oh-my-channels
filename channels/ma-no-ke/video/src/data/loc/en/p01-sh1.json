"subs": [
{
"t": 0.15,
"dur": 4.731,
"text": "Three million people watched an old woman eat. Nobody saw her son dump the food."
},
{
"t": 5.281,
"dur": 3.874,
"text": "Three months ago, my son started a channel. He called it Dinner with Mom."
},
{
"t": 9.405,
"dur": 2.964,
"text": "Every meal: braised fish, crab soup, fried eggs."
},
{
"t": 12.619,
"dur": 2.785,
"text": "Three million viewers. They cried. They sent money."
},
{
"t": 15.654,
"dur": 4.838,
"text": "The second he turned it off, he packed it up. Into a plastic bag, back to the restaurant."
},
{
"t": 20.742,
"dur": 1.542,
"text": "I got plain rice porridge."
},
{
"t": 22.534,
"dur": 3.697,
"text": "He isn't evil. He's in debt to an app. His phone buzzes all day."
},
{
"t": 26.482,
"dur": 4.522,
"text": "I'm not mad. I've got a secret too. Every night, I sneak out for a late meal."
},
{
"t": 31.154,
"dur": 0.898,
"text": "Just my head."
},
{
"t": 32.652,
"dur": 3.651,
"text": "What's her secret? I'll tell you next time. Full story on the channel."
}
],
