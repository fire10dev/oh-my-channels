"subs": [
{
"t": 0.15,
"dur": 2.511,
"text": "I… I'm still alive. Why are you checking me in?"
},
{
"t": 3.06,
"dur": 2.884,
"text": "You signed the paper. Whatever it says, that's the truth."
},
{
"t": 6.445,
"dur": 5.749,
"text": "There. A mistake. But by the book. Thanks to that mistake, Loc's wife back home sleeps soundly."
},
{
"t": 12.443,
"dur": 1.643,
"text": "Spare me! I'll burn a car for you!"
},
{
"t": 14.337,
"dur": 4.154,
"text": "I ride my bike to work. Your time isn't up. I'm not taking your life."
},
{
"t": 18.742,
"dur": 2.638,
"text": "I don't take lives. I take… something else."
},
{
"t": 21.88,
"dur": 3.44,
"text": "What does he take? Guess in the comments. I'll tell you next time."
}
],
