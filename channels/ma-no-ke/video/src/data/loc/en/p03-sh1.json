"subs": [
{
"t": 0.0,
"dur": 4.582,
"text": "Ma xo case file. If your family's been here three generations, listen up."
},
{
"t": 4.782,
"dur": 6.186,
"text": "One. It's a kid in a corner, usually by the kitchen. Been there since great-great-grandpa. Never left."
},
{
"t": 11.218,
"dur": 3.241,
"text": "Two. It guards the family stuff. Nothing leaves the house."
},
{
"t": 14.559,
"dur": 3.322,
"text": "Sell the house, and the house's things leave. I have to keep them here."
},
{
"t": 18.181,
"dur": 4.294,
"text": "Three. It's polite. Calls itself “your child,” calls you “sir.” Creepy polite."
},
{
"t": 22.576,
"dur": 2.207,
"text": "I'm not scaring anyone. I'm just counting."
},
{
"t": 25.081,
"dur": 4.712,
"text": "Four. Hear counting behind the wall at midnight? Don't celebrate. Might not be money."
},
{
"t": 30.494,
"dur": 5.973,
"text": "Great-great-grandpa gave me one job: our whole fortune's in the jar under the kitchen. Guard it. So I did."
},
{
"t": 37.067,
"dur": 5.228,
"text": "At Mr. Khai's house, it counted to four hundred thirteen. Full story on the channel."
}
],
