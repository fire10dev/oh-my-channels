"subs": [
{
"t": 0.0,
"dur": 3.529,
"text": "How to survive a ma giau. Learn from Bin, age ten."
},
{
"t": 3.729,
"dur": 2.068,
"text": "I waited for the tray. Nine. Ten. Midnight."
},
{
"t": 6.047,
"dur": 2.124,
"text": "One. Don't panic. Ask for Wi-Fi."
},
{
"t": 8.271,
"dur": 3.241,
"text": "You skipping homework too, mister? Can you get our Wi-Fi out here?"
},
{
"t": 11.762,
"dur": 2.061,
"text": "Eight hundred years, and nobody's asked me that."
},
{
"t": 14.122,
"dur": 2.906,
"text": "Two. Order milk tea. Note: leave at the stairwell."
},
{
"t": 17.279,
"dur": 3.309,
"text": "Three. Borrow a maintenance outlet. Call it a secret base."
},
{
"t": 20.988,
"dur": 1.783,
"text": "Am I a hiding ghost or a babysitter?"
},
{
"t": 23.571,
"dur": 4.059,
"text": "His family didn't look for him for three days. Full story on the channel."
}
],
