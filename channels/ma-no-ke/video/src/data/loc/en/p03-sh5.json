"subs": [
{
"t": 0.0,
"dur": 2.86,
"text": "Thirty-foot house. The tape never hit the back wall."
},
{
"t": 3.16,
"dur": 5.146,
"text": "First inspection: the door locked itself. The surveyor spent two hours in the bathroom."
},
{
"t": 8.557,
"dur": 7.514,
"text": "Second inspection: the house was thirty feet deep, but the surveyor couldn't reach the back wall. He checked the time. Two a.m."
},
{
"t": 16.321,
"dur": 4.44,
"text": "A Western guest left a one-star review: “A kid counted money all night.”"
},
{
"t": 21.16,
"dur": 5.755,
"text": "I'm this home's ma xo — a kitchen-corner ghost. I've lived by the stove since great-great-grandpa's time."
},
{
"t": 27.115,
"dur": 2.207,
"text": "I'm not scaring anyone. I'm just counting."
},
{
"t": 30.222,
"dur": 3.281,
"text": "Counting all night. Counting what? Full story on the channel."
}
],
