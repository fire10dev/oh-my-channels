"subs": [
{
"t": 0.0,
"dur": 5.777,
"text": "Three hours till dawn. If nobody bangs the tray and calls a name, the ma giau loses."
},
{
"t": 5.977,
"dur": 6.899,
"text": "Simple rules. I hide them, their family looks. Bang the brass tray, call their name. One bang and I bring them back. That's a game."
},
{
"t": 13.125,
"dur": 8.642,
"text": "There's a deadline, too. The family has to look before dawn on day four. If nobody comes, the kid walks home, and eight hundred years at my job… becomes a joke."
},
{
"t": 22.017,
"dur": 4.575,
"text": "Two a.m. Three hours till dawn. If this family won't bang the tray, I'll make them."
},
{
"t": 26.842,
"dur": 1.599,
"text": "I cut the power to the whole floor."
},
{
"t": 28.941,
"dur": 2.576,
"text": "Then I banged on the stairwell door. Bang. Bang. Bang."
},
{
"t": 32.118,
"dur": 3.005,
"text": "Who'll open that door? Full episode — link below."
}
],
