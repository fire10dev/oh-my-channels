"subs": [
{
"t": 0.0,
"dur": 3.698,
"text": "To sell the house, Mr. Khai had to bribe the ghost guarding it."
},
{
"t": 3.849,
"dur": 5.755,
"text": "I'm this home's ma xo — a kitchen-corner ghost. I've lived by the stove since great-great-grandpa's time."
},
{
"t": 9.804,
"dur": 3.183,
"text": "Hey, ma xo. Sign and I'll cut you in. Here. Banana rice cake offering."
},
{
"t": 14.537,
"dur": 1.536,
"text": "You ate it! That means you agree!"
},
{
"t": 16.274,
"dur": 3.073,
"text": "I don't take bribes, sir. I only eat rice cake offerings."
},
{
"t": 20.246,
"dur": 3.46,
"text": "Takes the offering, skips the job. Now that's a gig I want."
},
{
"t": 24.106,
"dur": 5.728,
"text": "The bribe didn't work, so Mr. Khai dug up the jar. What'd he find? Full story on the channel."
}
],
