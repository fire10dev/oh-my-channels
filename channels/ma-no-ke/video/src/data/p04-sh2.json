"subs": [
{
"t": 0.0,
"dur": 3.101,
"text": "Cách sống sót khi bị ma giấu. Học thằng Bin, mười tuổi."
},
{
"t": 3.301,
"dur": 2.75,
"text": "Tao ngồi chờ tiếng mâm. Chín giờ. Mười giờ. Nửa đêm."
},
{
"t": 6.301,
"dur": 1.781,
"text": "Một. Đừng sợ. Hỏi wifi."
},
{
"t": 8.182,
"dur": 3.25,
"text": "Chú cũng trốn học à? Ở đây bắt được wifi nhà cháu không chú?"
},
{
"t": 11.682,
"dur": 2.151,
"text": "Tám trăm năm, chưa đứa nào hỏi tao câu đó."
},
{
"t": 14.132,
"dur": 2.635,
"text": "Hai. Đặt trà sữa, ghi chú: treo cửa thoát hiểm."
},
{
"t": 17.017,
"dur": 2.865,
"text": "Ba. Sạc ké ổ bảo trì. Gọi là căn cứ bí mật."
},
{
"t": 20.282,
"dur": 2.006,
"text": "Tao là ma giấu, hay là trông trẻ?"
},
{
"t": 23.088,
"dur": 3.562,
"text": "Nhà nó ba ngày không ai tìm. Tao kể ở bản đầy đủ, link dưới."
}
],
