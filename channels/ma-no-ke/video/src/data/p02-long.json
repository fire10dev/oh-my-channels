"subs": [
{
"t": 3.7,
"dur": 2.9,
"text": "Tôi… tôi còn sống mà? Điểm danh tôi làm gì?"
},
{
"t": 6.75,
"dur": 4.082,
"text": "Âm phủ làm theo giấy. Giấy có tên anh. Có mặt."
},
{
"t": 11.232,
"dur": 4.896,
"text": "Khoan. Công chức âm phủ, đi làm đúng giờ, điểm danh một ông giám đốc còn sống nhăn."
},
{
"t": 16.378,
"dur": 2.552,
"text": "Nhầm à? Nhầm thật. Mà nhầm đúng người."
},
{
"t": 19.181,
"dur": 2.025,
"text": "Lùi lại mười ngày. Tao kể."
},
{
"t": 21.706,
"dur": 4.082,
"text": "Ta là thần trùng. Ta không bắt ai. Ta làm sổ."
},
{
"t": 26.038,
"dur": 6.187,
"text": "Hồ sơ. Xưởng may Phát Đạt. Ba trăm công nhân. Ca đêm đến hai giờ sáng."
},
{
"t": 32.475,
"dur": 2.735,
"text": "Giám đốc Phát. Câu cửa miệng: xưởng là nhà."
},
{
"t": 35.461,
"dur": 5.602,
"text": "Mà ở nhà thì ai tính giờ về? Nên máy chấm công ở đây chỉ có nút vào. Không có nút ra."
},
{
"t": 41.313,
"dur": 3.05,
"text": "Tăng ca là cống hiến! Ai về sớm, trừ chuyên cần!"
},
{
"t": 44.763,
"dur": 5.851,
"text": "Trần Văn Lộc. Tổ may số ba. Hai giờ mười sáng thứ Năm, gục xuống máy may."
},
{
"t": 50.863,
"dur": 4.166,
"text": "Không dậy nữa. Sổ ghi: hai giờ mười. Tại xưởng."
},
{
"t": 55.63,
"dur": 1.6,
"text": "Anh Lộc… anh Lộc ơi."
},
{
"t": 57.73,
"dur": 6.055,
"text": "Việc đầu tiên lão giám đốc hỏi không phải anh Lộc thế nào. Lão hỏi: chỗ đó camera có quay tới không."
},
{
"t": 64.034,
"dur": 6.951,
"text": "Mất ở xưởng, trong giờ làm, là tai nạn lao động. Phải đền. Thanh tra còn hỏi vì sao máy chấm công không có nút ra."
},
{
"t": 71.236,
"dur": 5.786,
"text": "Nên đêm đó lão tự viết tờ khai. Hai giờ mười, sửa thành năm giờ sáng. Tại xưởng, sửa thành tại nhà."
},
{
"t": 77.271,
"dur": 6.051,
"text": "Vợ anh Lộc ở quê chưa lên kịp. Lão ký luôn chỗ người khai. Mục quan hệ, lão viết: như người nhà."
},
{
"t": 83.572,
"dur": 2.563,
"text": "Chị tổ trưởng Hồng đứng sau cửa. Thấy hết."
},
{
"t": 86.385,
"dur": 2.359,
"text": "Giấy ghi thế nào, sự thật là thế."
},
{
"t": 89.344,
"dur": 6.187,
"text": "Ta không đọc đồng hồ. Ta đọc giấy. Giấy là thủ tục. Thủ tục là ta."
},
{
"t": 95.782,
"dur": 7.114,
"text": "Năm giờ sáng là giờ trùng. Ai mất vào giờ trùng, ta phải quay lại điểm danh thêm một người nhà."
},
{
"t": 103.145,
"dur": 3.24,
"text": "Người nhà anh Lộc: một người vợ. Ở quê."
},
{
"t": 107.385,
"dur": 3.271,
"text": "Khoan khoan. Giám đốc sửa giấy, mà nhà người ta phải trả à?"
},
{
"t": 111.056,
"dur": 3.449,
"text": "Tin đồn chạy khắp xưởng, nhanh hơn kim máy may. Trùng tang."
},
{
"t": 114.755,
"dur": 3.68,
"text": "Anh Lộc mất ở đây, lúc hai giờ mười. Cả tổ ba đều biết."
},
{
"t": 118.685,
"dur": 2.981,
"text": "Trùng tang là mê tín! Ai nghỉ làm vì ma, trừ lương!"
},
{
"t": 121.916,
"dur": 4.976,
"text": "Ông thầy đầu ngõ lại bán vòng chống trùng, giảm năm mươi phần trăm. Vẫn ông ấy."
},
{
"t": 127.392,
"dur": 5.514,
"text": "Ba giờ sáng thứ Bảy. Xưởng may. Ta gõ mõ ba nhịp, mở hồ sơ."
},
{
"t": 133.156,
"dur": 5.429,
"text": "Cần điểm danh: một người nhà. Tờ khai ghi: Nguyễn Văn Phát. Như người nhà."
},
{
"t": 138.835,
"dur": 1.893,
"text": "Ta điểm danh người nhà."
},
{
"t": 142.478,
"dur": 2.644,
"text": "Cùng giây đó, điện thoại giám đốc sáng lên."
},
{
"t": 146.922,
"dur": 2.745,
"text": "Tôi là giám đốc! Tôi không phải người nhà nó!"
},
{
"t": 149.917,
"dur": 4.166,
"text": "Giấy anh ký. Giấy ghi thế nào, sự thật là thế."
},
{
"t": 154.684,
"dur": 5.252,
"text": "Đấy. Nhầm. Nhưng nhầm đúng quy trình. Nhờ cái nhầm ấy, vợ anh Lộc ở quê vẫn ngủ ngon."
},
{
"t": 160.436,
"dur": 2.749,
"text": "Tha cho tôi! Tôi đốt cho ông cái xe hơi!"
},
{
"t": 163.435,
"dur": 4.756,
"text": "Ta đi làm bằng xe đạp. Mạng anh chưa đến giờ. Ta không lấy."
},
{
"t": 168.441,
"dur": 1.64,
"text": "Ta lấy lịch của anh."
},
{
"t": 170.581,
"dur": 7.282,
"text": "Người nhà thì phải để tang. Ba giờ sáng mỗi đêm, quấn khăn, quỳ trước ảnh anh Lộc. Như con trai."
},
{
"t": 178.113,
"dur": 3.093,
"text": "Ban ngày đi gặp đối tác. Khăn tang không tháo ra được."
},
{
"t": 181.456,
"dur": 5.604,
"text": "Đêm nào lão ngủ quên, máy chấm công tự in tên. Sáng ra, tên giám đốc dán kín cửa xưởng."
},
{
"t": 187.31,
"dur": 1.224,
"text": "Bao giờ mới hết?"
},
{
"t": 188.934,
"dur": 7.872,
"text": "Khi giấy đúng. Hết bốn mươi chín ngày mà giấy vẫn sai, ta điểm danh lần nữa. Lần đó không cần thẻ."
},
{
"t": 197.805,
"dur": 7.132,
"text": "Đêm thứ bốn mươi tám, lão tự sửa lại giấy. Hai giờ mười. Tại xưởng. Tai nạn lao động. Tiền đền đến tay vợ anh Lộc."
},
{
"t": 205.187,
"dur": 5.514,
"text": "Hai giờ mười không phải giờ trùng. Hồ sơ không còn người nhà. Hết thẩm quyền."
},
{
"t": 210.951,
"dur": 3.361,
"text": "Máy chấm công giờ có nút ra. Tăng ca thì tính tiền."
},
{
"t": 214.562,
"dur": 6.945,
"text": "Ta đóng sổ. Ta không lấy mạng nó. Ta lấy lịch của nó. Với loại người này, thế còn đau hơn."
},
{
"t": 221.757,
"dur": 4.082,
"text": "À. Ba đêm nó quỳ muộn. Tháng này, trừ chuyên cần."
},
{
"t": 226.439,
"dur": 4.974,
"text": "Ba trăm năm ngồi nóc tủ, lần đầu tao thấy âm phủ làm việc đúng giờ hơn công ty."
},
{
"t": 231.913,
"dur": 5.16,
"text": "Tuần sau: đứa trẻ giữ của ba đời trong căn nhà phố cổ, và cái hũ không ai được mở."
},
{
"t": 237.324,
"dur": 4.888,
"text": "Bấm đăng ký đi. Không thì ba giờ sáng nay, máy chấm công nhà mày in tên mày đấy."
}
],
