"subs": [
{
"t": 0.0,
"dur": 2.707,
"text": "Muốn bán nhà, ông Khải phải hối lộ con ma giữ nhà."
},
{
"t": 2.857,
"dur": 3.46,
"text": "Con là ma xó nhà này. Con ở cái xó cạnh bếp từ thời cụ cố."
},
{
"t": 6.517,
"dur": 3.274,
"text": "Ma xó ơi. Ký xong tao chia mày phần. Đây, oản chuối."
},
{
"t": 11.341,
"dur": 1.912,
"text": "Ăn rồi nhé! Ăn là đồng ý đấy nhé!"
},
{
"t": 13.454,
"dur": 2.282,
"text": "Con không ăn hối lộ, ông ạ. Con chỉ ăn oản."
},
{
"t": 16.635,
"dur": 2.738,
"text": "Ăn oản không làm việc. Nghề này tao thèm thật."
},
{
"t": 19.774,
"dur": 4.726,
"text": "Mua ma không được, ông Khải đi đào hũ. Đào ra cái gì? Tao kể ở bản đầy đủ, link dưới."
}
],
