"subs": [
{
"t": 0.0,
"dur": 2.946,
"text": "Hồ sơ ma xó. Nhà mày ba đời thì nghe cho kỹ."
},
{
"t": 3.146,
"dur": 5.132,
"text": "Một. Nó là đứa bé ngồi ở xó nhà, thường là xó bếp. Ở từ thời cụ cố, chưa đi đâu bao giờ."
},
{
"t": 8.528,
"dur": 3.33,
"text": "Hai. Nó giữ của. Cái gì của nhà, nó không cho ra khỏi nhà."
},
{
"t": 11.958,
"dur": 2.36,
"text": "Bán nhà là của ra khỏi nhà. Con phải giữ."
},
{
"t": 14.618,
"dur": 3.174,
"text": "Ba. Nó ngoan. Xưng con, gọi ông. Ngoan đến phát sợ."
},
{
"t": 17.892,
"dur": 1.9,
"text": "Con không dọa ai. Con chỉ đếm."
},
{
"t": 20.091,
"dur": 3.864,
"text": "Bốn. Nửa đêm nghe tiếng đếm tiền sau tường, đừng mừng. Chưa chắc đã là tiền."
},
{
"t": 24.656,
"dur": 4.394,
"text": "Cụ dặn con đúng một câu: cả gia tài nhà mình nằm trong cái hũ dưới bếp. Giữ lấy. Con giữ."
},
{
"t": 29.65,
"dur": 4.038,
"text": "Nhà ông Khải nó đếm ra bốn trăm mười ba. Tao kể ở bản đầy đủ, link dưới."
}
],
