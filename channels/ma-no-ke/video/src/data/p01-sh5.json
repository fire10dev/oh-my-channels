"subs": [
{
"t": 0.15,
"dur": 4.57,
"text": "Con tôi đắp chăn cho mẹ, lần đầu tiên trong ba tháng. Và đó là điều tệ nhất."
},
{
"t": 5.12,
"dur": 5.822,
"text": "Nó không hét. Nó không dám lật chăn. Tay run, nó kéo chăn trùm kín. Kín cổ. Kín hết."
},
{
"t": 11.192,
"dur": 1.741,
"text": "Ngoài cửa sổ, tôi thấy hết."
},
{
"t": 13.183,
"dur": 1.488,
"text": "Và tôi không về được nữa."
},
{
"t": 15.671,
"dur": 4.345,
"text": "Tao suýt đánh rơi điếu cày. Còn hai tiếng là gà gáy. Bà ấy trốn đâu?"
},
{
"t": 20.267,
"dur": 2.742,
"text": "Chỗ nào tối, ấm, tròn vừa một cái đầu?"
},
{
"t": 23.508,
"dur": 3.007,
"text": "Đoán đi, comment xuống dưới. Mai tao mở nắp."
}
],
