"subs": [
{
"t": 0.15,
"dur": 2.324,
"text": "Bốn giây. Cái chăn phẳng ở chỗ cổ."
},
{
"t": 3.274,
"dur": 4.071,
"text": "Chỉ bà Hạnh phòng bên là không bình luận. Bà sang, ngồi, nhìn tôi rất lâu."
},
{
"t": 7.595,
"dur": 1.897,
"text": "Bà Tư này. Bà cẩn thận."
},
{
"t": 9.742,
"dur": 6.325,
"text": "Không phải, con bà cẩn thận. Mà là, bà cẩn thận. Hóa ra có người biết mình là ma, mà vẫn lo cho mình."
},
{
"t": 16.567,
"dur": 3.078,
"text": "Đêm đó nó gắn camera lên nóc tủ. Đặt tiêu đề:"
},
{
"t": 21.745,
"dur": 3.156,
"text": "Hai giờ mười lăm, nó ngủ gục. Chín nghìn người thức thay nó."
},
{
"t": 25.151,
"dur": 1.494,
"text": "Và đầu tôi, nhẹ dần."
},
{
"t": 27.445,
"dur": 2.904,
"text": "Điện thoại rung. Nó tỉnh. Nó nhìn sang giường."
},
{
"t": 30.749,
"dur": 1.927,
"text": "Nó làm gì tiếp? Mai tao kể."
}
],
