"subs": [
{
"t": 0.0,
"dur": 2.559,
"text": "Cách sống sót khi nhà mày có ma xó. Ba điều."
},
{
"t": 2.759,
"dur": 4.663,
"text": "Một. Đừng bán nhà. Thợ đo vào khảo sát, cửa tự khóa, ngồi trong nhà vệ sinh hai tiếng."
},
{
"t": 7.672,
"dur": 2.36,
"text": "Bán nhà là của ra khỏi nhà. Con phải giữ."
},
{
"t": 10.332,
"dur": 2.711,
"text": "Hai. Đừng hối lộ. Nó ăn oản thật, nhưng không làm việc."
},
{
"t": 13.294,
"dur": 2.282,
"text": "Con không ăn hối lộ, ông ạ. Con chỉ ăn oản."
},
{
"t": 15.975,
"dur": 3.576,
"text": "Ba. Đừng mở cái hũ dưới bếp. Ba đời không ai mở là có lý do."
},
{
"t": 20.051,
"dur": 3.807,
"text": "Còn lỡ mở rồi thì chúc mừng. Mọi thứ trong hũ là của mày. Toàn bộ."
},
{
"t": 24.658,
"dur": 4.039,
"text": "Ông Khải mở rồi. Trong hũ có gì? Tao kể ở bản đầy đủ, link dưới."
}
],
