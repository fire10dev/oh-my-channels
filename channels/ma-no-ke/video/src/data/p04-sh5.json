"t": 1.65,
"dur": 4.977,
"text": "Bố họp trực tuyến. Mẹ livestream. Thằng con chơi game. Ba người, ba cái màn hình, một cái sofa."
},
{
"t": 6.877,
"dur": 3.098,
"text": "Ông bố này ba ngày họp trực tuyến. Không biết con mình đi đâu."
},
{
"t": 10.224,
"dur": 2.24,
"text": "Hôm nay Bin ngoan thế. Không đòi gì."
},
{
"t": 12.714,
"dur": 2.171,
"text": "Thằng ngồi ghế là bùn. Ông bố gật đầu."
},
{
"t": 15.185,
"dur": 1.68,
"text": "Ừ. Em xin phép tắt cam."
},
{
"t": 17.665,
"dur": 2.31,
"text": "Ba ngày, ông ấy nói đúng một câu. Câu đó."
},
{
"t": 20.575,
"dur": 2.394,
"text": "Con thật ở đâu? Link bản đầy đủ ngay dưới."
}
