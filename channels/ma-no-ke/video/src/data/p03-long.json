"subs": [
{
"t": 2.05,
"dur": 2.061,
"text": "…bốn trăm mười hai. Bốn trăm mười ba."
},
{
"t": 4.411,
"dur": 1.975,
"text": "Ai… ai đấy? Đếm cái gì đấy?"
},
{
"t": 6.636,
"dur": 2.205,
"text": "Đếm của nhà mình, ông ạ. Sắp xong rồi."
},
{
"t": 9.841,
"dur": 5.16,
"text": "Lại mò vào xem à? Tuần này ở phố cổ. Một căn nhà ba đời, một cái hũ chưa ai mở."
},
{
"t": 15.252,
"dur": 3.369,
"text": "Và một đứa giữ nó. Ngoan lắm. Ngoan đến phát sợ."
},
{
"t": 18.871,
"dur": 2.192,
"text": "Lùi lại một tháng. Cho nó kể."
},
{
"t": 21.563,
"dur": 3.46,
"text": "Con là ma xó nhà này. Con ở cái xó cạnh bếp từ thời cụ cố."
},
{
"t": 25.272,
"dur": 4.394,
"text": "Cụ dặn con đúng một câu: cả gia tài nhà mình nằm trong cái hũ dưới bếp. Giữ lấy. Con giữ."
},
{
"t": 29.916,
"dur": 4.954,
"text": "Welcome! Nhà cổ ba đời, giữ trọn hồn phố cổ. Hai triệu một đêm, chụp bàn thờ thêm năm mươi nghìn."
},
{
"t": 35.12,
"dur": 4.982,
"text": "Giữ hồn phố cổ bằng cách bán vé xem bàn thờ. Cụ cố mà biết thì cụ thu phí lại."
},
{
"t": 40.502,
"dur": 5.2,
"text": "Sáu mươi tỷ. Đập trắng bên trong. Giữ lại cái cổng rêu cho khách Tây chụp ảnh bảo tồn."
},
{
"t": 45.952,
"dur": 1.668,
"text": "Ký! Đập luôn cái bếp cũng được."
},
{
"t": 47.87,
"dur": 2.36,
"text": "Bán nhà là của ra khỏi nhà. Con phải giữ."
},
{
"t": 50.73,
"dur": 4.348,
"text": "Buổi khảo sát thứ nhất: cửa tự khóa. Thợ đo ngồi trong nhà vệ sinh hai tiếng."
},
{
"t": 55.328,
"dur": 6.334,
"text": "Buổi thứ hai: căn nhà sâu mười mét, thợ kéo thước mãi không chạm tường sau. Nhìn đồng hồ, đã hai giờ sáng."
},
{
"t": 61.912,
"dur": 4.272,
"text": "Khách Tây để lại review một sao: phòng có trẻ con đếm tiền cả đêm."
},
{
"t": 66.434,
"dur": 1.9,
"text": "Con không dọa ai. Con chỉ đếm."
},
{
"t": 68.833,
"dur": 3.274,
"text": "Ma xó ơi. Ký xong tao chia mày phần. Đây, oản chuối."
},
{
"t": 72.358,
"dur": 2.282,
"text": "Con không ăn hối lộ, ông ạ. Con chỉ ăn oản."
},
{
"t": 76.539,
"dur": 2.738,
"text": "Ăn oản không làm việc. Nghề này tao thèm thật."
},
{
"t": 79.778,
"dur": 3.052,
"text": "Bán nhà thôi nhé. Cái hũ cụ cố chôn dưới bếp thì không tính!"
},
{
"t": 83.08,
"dur": 2.16,
"text": "Hũ sành thì báu gì. Anh cứ giữ."
},
{
"t": 85.49,
"dur": 5.877,
"text": "Ba đời không ai được mở. Ba đời giàu nhất phố. Trong đầu ông Khải, cái hũ chỉ có thể là vàng."
},
{
"t": 91.617,
"dur": 3.893,
"text": "Thêm một dòng. Hũ dưới nền, thuộc bên bán. Toàn bộ, kể cả những gì bên trong."
},
{
"t": 95.76,
"dur": 4.56,
"text": "Sáng thứ Bảy mở hũ, kiểm kê, ra công chứng. Anh đặt cọc sáu tỷ, em giữ."
},
{
"t": 100.57,
"dur": 2.555,
"text": "Nhớ cái dòng đó. Tí nữa nó quay lại."
},
{
"t": 103.725,
"dur": 6.68,
"text": "Đêm thứ Sáu, ông Khải lẻn xuống bếp với cái xẻng. Định lấy vàng trước. Sáng ra để hũ rỗng cho bên mua."
},
{
"t": 110.655,
"dur": 2.922,
"text": "Ông chui vào kho lấy cuốc. Cửa kho đóng lại."
},
{
"t": 113.827,
"dur": 1.05,
"text": "…một. Hai. Ba."
},
{
"t": 115.378,
"dur": 1.609,
"text": "Mở cửa! Tao là chủ nhà!"
},
{
"t": 117.237,
"dur": 3.54,
"text": "Con biết, ông ạ. Bán nhà thì phải kiểm kê. Cụ dặn. Con đếm cho ông nghe."
},
{
"t": 121.027,
"dur": 1.985,
"text": "…bốn trăm mười hai. Bốn trăm mười ba. Hết."
},
{
"t": 125.012,
"dur": 5.965,
"text": "Sáng thứ Bảy. Cửa kho tự mở. Hũ được đào lên trước mặt bên mua, luật sư, và nửa cái phố."
},
{
"t": 131.226,
"dur": 2.051,
"text": "Bốn trăm mười ba tờ. Giấy nợ, ông ạ."
},
{
"t": 133.527,
"dur": 3.225,
"text": "Cụ cố vay mua đất. Ông nội vay đắp lãi. Bố ông vay đảo nợ."
},
{
"t": 137.002,
"dur": 3.698,
"text": "Ba đời, chưa trả một đồng. Lần nào cũng cầm cố… chính căn nhà này."
},
{
"t": 141.7,
"dur": 4.357,
"text": "Chủ nợ thì ở ngay trong phố. Phố cổ mà. Nhà nào cũng còn giữ giấy."
},
{
"t": 146.307,
"dur": 4.24,
"text": "Nhà đang tranh chấp thì công chứng không ký. Bên em rút. Cọc anh đền."
},
{
"t": 150.797,
"dur": 4.4,
"text": "À, phụ lục anh tự viết. Hũ và toàn bộ bên trong thuộc về anh. Chúc mừng."
},
{
"t": 155.447,
"dur": 1.148,
"text": "Thế… tôi còn lại gì?"
},
{
"t": 156.995,
"dur": 1.117,
"text": "Còn cái hũ, ông ạ."
},
{
"t": 158.911,
"dur": 4.267,
"text": "Ông Khải không bán nhà nữa. Ông bán vé xem hũ. Khách đông gấp đôi."
},
{
"t": 163.428,
"dur": 2.993,
"text": "Con giữ của nhà này ba đời. Nhà này giàu nhất phố… về nợ."
},
{
"t": 166.921,
"dur": 4.801,
"text": "Ba trăm năm ngồi nóc tủ, tao học được một điều: hũ nào không ai dám mở, đừng mở."
},
{
"t": 172.222,
"dur": 6.144,
"text": "Thứ Hai này: một nhà chung cư mất thằng con ba ngày… mà không ai biết. Vì cả nhà đang bận nhìn điện thoại."
},
{
"t": 178.616,
"dur": 5.511,
"text": "Bấm đăng ký đi. Không thì đêm nay, có đứa ngồi sau tủ nhà mày đếm số video mày chưa xem."
}
],
