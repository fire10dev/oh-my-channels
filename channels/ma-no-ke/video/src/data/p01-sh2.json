"subs": [
{
"t": 0.15,
"dur": 1.91,
"text": "Mẹ chỉ dặn con đúng một điều."
},
{
"t": 2.46,
"dur": 6.075,
"text": "Tôi là ma lai. Hai giờ sáng, đầu tôi nhấc khỏi cổ, bay qua song cửa. Trước khi gà gáy thì về lắp lại."
},
{
"t": 8.785,
"dur": 2.823,
"text": "Thành phố bây giờ khó bay lắm. Camera khắp nơi."
},
{
"t": 11.858,
"dur": 4.325,
"text": "Ăn gì à? Cá kho thừa ở thùng rác. Chia đôi với con mèo mướp. Nó đang chửa."
},
{
"t": 16.434,
"dur": 1.74,
"text": "Bà ngoại tôi dặn đúng một luật."
},
{
"t": 18.574,
"dur": 2.988,
"text": "Con ơi. Mẹ ngủ thì đừng đắp chăn lên cổ mẹ."
},
{
"t": 21.812,
"dur": 0.849,
"text": "Mẹ lại mê tín."
},
{
"t": 22.911,
"dur": 1.66,
"text": "Nó cười. Rồi nó quên."
},
{
"t": 25.171,
"dur": 3.455,
"text": "Nó quên vào đêm nào? Mai tao kể tiếp. Theo dõi đi."
}
],
