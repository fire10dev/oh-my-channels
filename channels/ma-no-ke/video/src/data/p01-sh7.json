"subs": [
{
"t": 0.15,
"dur": 3.238,
"text": "Năm mươi phần trăm doanh thu. Vì cái đầu này là của mẹ."
},
{
"t": 3.788,
"dur": 5.733,
"text": "Clip ấy giờ ba mươi triệu view. Không ai tin là thật. Tốt. Không ai tin thì tôi vẫn đi ăn khuya được."
},
{
"t": 9.772,
"dur": 5.408,
"text": "Nó trả hết nợ. Tối nào vẫn dựng máy trước mâm. Nhưng tắt máy rồi, nó ngồi ăn với tôi."
},
{
"t": 15.43,
"dur": 1.819,
"text": "Còn tôi đưa nó một tờ giấy."
},
{
"t": 19.999,
"dur": 7.489,
"text": "Ma lai năm mươi năm chưa dọa được ai. Lên mạng ba tháng, có hợp đồng chia tiền. Tao ngồi nóc tủ mấy trăm năm, chưa ai trả đồng nào."
},
{
"t": 27.737,
"dur": 5.16,
"text": "Tuần sau: một ông công chức âm phủ đến xưởng may điểm danh, và điểm nhầm đúng một người."
},
{
"t": 33.147,
"dur": 3.723,
"text": "Bấm đăng ký đi. Không thì tối nay tao ngồi nóc tủ nhà mày đấy."
}
],
