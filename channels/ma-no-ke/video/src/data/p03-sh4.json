"subs": [
{
"t": 0.0,
"dur": 4.954,
"text": "Welcome! Nhà cổ ba đời, giữ trọn hồn phố cổ. Hai triệu một đêm, chụp bàn thờ thêm năm mươi nghìn."
},
{
"t": 5.204,
"dur": 4.982,
"text": "Giữ hồn phố cổ bằng cách bán vé xem bàn thờ. Cụ cố mà biết thì cụ thu phí lại."
},
{
"t": 10.585,
"dur": 5.2,
"text": "Sáu mươi tỷ. Đập trắng bên trong. Giữ lại cái cổng rêu cho khách Tây chụp ảnh bảo tồn."
},
{
"t": 16.035,
"dur": 1.668,
"text": "Ký! Đập luôn cái bếp cũng được."
},
{
"t": 19.253,
"dur": 2.36,
"text": "Bán nhà là của ra khỏi nhà. Con phải giữ."
},
{
"t": 22.414,
"dur": 4.394,
"text": "Cụ dặn con đúng một câu: cả gia tài nhà mình nằm trong cái hũ dưới bếp. Giữ lấy. Con giữ."
},
{
"t": 27.408,
"dur": 3.567,
"text": "Và nó giữ thật. Giữ kiểu gì, tao kể ở bản đầy đủ, link dưới."
}
],
