"subs": [
{
"t": 0.0,
"dur": 2.554,
"text": "Nhà sâu mười mét. Kéo thước mãi không chạm tường."
},
{
"t": 2.854,
"dur": 4.348,
"text": "Buổi khảo sát thứ nhất: cửa tự khóa. Thợ đo ngồi trong nhà vệ sinh hai tiếng."
},
{
"t": 7.453,
"dur": 6.334,
"text": "Buổi thứ hai: căn nhà sâu mười mét, thợ kéo thước mãi không chạm tường sau. Nhìn đồng hồ, đã hai giờ sáng."
},
{
"t": 14.037,
"dur": 4.272,
"text": "Khách Tây để lại review một sao: phòng có trẻ con đếm tiền cả đêm."
},
{
"t": 18.708,
"dur": 3.46,
"text": "Con là ma xó nhà này. Con ở cái xó cạnh bếp từ thời cụ cố."
},
{
"t": 22.368,
"dur": 1.9,
"text": "Con không dọa ai. Con chỉ đếm."
},
{
"t": 25.168,
"dur": 3.565,
"text": "Đếm cả đêm. Mà đếm cái gì? Tao kể ở bản đầy đủ, link dưới."
}
],
